# Reddit API — create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=ProductIdeaMiner/1.0 by your_username

# TinyFish — get key at https://www.tinyfish.ai
TINYFISH_API_KEY=

# Anthropic — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase — create project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Gmail — use App Password (not your real password)
# Enable at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
RECIPIENT_EMAIL=your@gmail.com

# Webhooks (Optional)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Tuneable settings
RUN_INTERVAL_HOURS=6
MIN_UPVOTES=10
MIN_TOTAL_SCORE=15
TOP_IDEAS_PER_DIGEST=10
