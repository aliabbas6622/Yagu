# Reddit API - create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=ProductIdeaMiner/1.0 by your_username
REDDIT_USE_SCRAPLING_FALLBACK=true

# TinyFish - optional; disabled by default to reduce paid/AI scraping usage.
TINYFISH_API_KEY=
QUORA_SCRAPE_ENABLED=false

# AI provider selection for CrewAI/LiteLLM analysis.
# Supported AI_PROVIDER values: anthropic, gemini, openrouter, grok, xai, groq, openai
# Leave AI_MODEL blank to use the app's default for AI_PROVIDER.
AI_PROVIDER=gemini
AI_MODEL=
AI_ANALYSIS_ENABLED=true
MAX_AI_POSTS_PER_RUN=1
SAVE_MANUAL_CANDIDATES=true
MAX_MANUAL_CANDIDATES_PER_RUN=20
ORCHESTRATOR_MODEL=gemini-2.0-flash

# AI provider keys. Numbered variants are supported for your local key rotation.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_API_1=
GEMINI_API_2=
GEMINI_API_3=
OPENROUTER_API_KEY=
OPENROUTER_1=
OPENROUTER_2=
XAI_API_KEY=
GROQ_API_KEY=
GROQ_API_1=
GROQ_API_2=
OPENAI_API_KEY=

# Supabase
# Project URL: https://supabase.com/dashboard/project/jszynhssdptfqmjqkola
# Use a server-side secret/service role key for this local backend worker.
# Do not expose secret or service role keys in browser/frontend code.
SUPABASE_URL=https://jszynhssdptfqmjqkola.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Gmail - use App Password (not your real password)
# Enable at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
RECIPIENT_EMAIL=your@gmail.com

# Webhooks (Optional)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Tuneable settings
RUN_INTERVAL_HOURS=6
MIN_UPVOTES=10
MIN_TOTAL_SCORE=15
TOP_IDEAS_PER_DIGEST=10

# Reliability
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=3
RETRY_WAIT_SECONDS=2
LLM_ANALYSIS_RETRIES=1
